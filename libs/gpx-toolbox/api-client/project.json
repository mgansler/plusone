{
  "name": "gpx-toolbox-api-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gpx-toolbox/api-client/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "fetch-strava-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/scripts/fetch-strava-spec.ts"],
      "outputs": ["{projectRoot}/strava.preprocessed.json"],
      "options": {
        "command": "tsx libs/gpx-toolbox/api-client/scripts/fetch-strava-spec.ts"
      }
    },
    "generate-api-client": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["fetch-strava-spec"],
      "inputs": [
        {
          "externalDependencies": ["orval"]
        },
        "{projectRoot}/orval.config.ts",
        "{projectRoot}/src/**/*",
        "!{projectRoot}/src/gen/*",
        "{workspaceRoot}/apps/gpx-toolbox/gpx-toolbox-backend/gpx-toolbox-internal.json",
        "{projectRoot}/strava.preprocessed.json"
      ],
      "outputs": ["{projectRoot}/src/gen/*"],
      "options": {
        "command": "yarn orval --config libs/gpx-toolbox/api-client/orval.config.cjs"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/gpx-toolbox/api-client/tsconfig.lib.json",
          "tsc --noEmit -p libs/gpx-toolbox/api-client/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
