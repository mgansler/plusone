datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client"
  output     = "src/lib/client"
  engineType = "client"
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  avatarUrl String?
  createdAt DateTime @default(now())

  identities       Identity[]
  stravaConnection StravaConnection?

  @@map("users")
}

// How a user logs in. `subject` is the stable id of the identity provider (e.g. the `sub` claim), not the email.
model Identity {
  id        String           @id @default(uuid())
  userId    String
  provider  IdentityProvider
  subject   String
  email     String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("identities")
}

enum IdentityProvider {
  google
}

// Optional link to a Strava account, independent of how the user logs in
model StravaConnection {
  userId         String    @id
  stravaId       String    @unique
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  connectedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_connections")
}

model Route {
  id               String      @id @default(uuid())
  name             String
  description      String?
  gpxContent       String // Raw GPX XML
  polyline         Json // [{ lat: Float, lng: Float }]
  stats            Json // { distance, elevationGain, elevationLoss }
  // Denormalized from polyline/stats so routes can be filtered and sorted in SQL
  distance         Float? // meters
  elevationGain    Float? // meters
  minLat           Float?
  maxLat           Float?
  minLng           Float?
  maxLng           Float?
  source           RouteSource
  status           RouteStatus @default(planned)
  ratingTags       Json // ["Nochmal fahren", "Anpassung nötig", ...]
  notes            String?
  userId           String? // User id (nullable for imports without an owner)
  stravaRouteId    String?     @unique
  stravaActivityId String?     @unique // Strava activity the route was created from (link to activities: Activity.routeId)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  activities Activity[]

  @@index([userId, minLat, maxLat])
  @@map("routes")
}

enum RouteSource {
  stravaRoute
  stravaActivity
  manualImport
}

enum RouteStatus {
  planned
  ridden
  foundOnline
}

model Activity {
  id               String   @id @default(uuid())
  routeId          String
  userId           String? // User id (nullable for imports without an owner)
  stravaActivityId String?  @unique
  title            String?  // Activity title (from Strava or manual entry)
  riddenAt         DateTime
  duration         Int? // seconds
  avgHr            Int?
  maxHr            Int?
  notes            String?
  weather          String? // JSON: Open-Meteo data for ride date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("activities")
}
