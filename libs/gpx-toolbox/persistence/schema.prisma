datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client"
  output     = "src/lib/client"
  engineType = "client"
}

model User {
  id             String  @id @default(uuid())
  stravaId       String  @unique
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  name           String?
  avatarUrl      String?

  @@map("users")
}

model Route {
  id               String      @id @default(uuid())
  name             String
  description      String?
  gpxContent       String // Raw GPX XML
  polyline         Json // [{ lat: Float, lng: Float }]
  stats            Json // { distance, elevationGain, elevationLoss }
  // Denormalized from polyline/stats so routes can be filtered and sorted in SQL
  distance         Float? // meters
  elevationGain    Float? // meters
  minLat           Float?
  maxLat           Float?
  minLng           Float?
  maxLng           Float?
  source           RouteSource
  status           RouteStatus @default(planned)
  ratingTags       Json // ["Nochmal fahren", "Anpassung nötig", ...]
  notes            String?
  userId           String? // Strava user ID (nullable for manual imports)
  stravaRouteId    String?     @unique
  stravaActivityId String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  activities Activity[]

  @@index([userId, minLat, maxLat])
  @@map("routes")
}

enum RouteSource {
  stravaRoute
  stravaActivity
  manualImport
}

enum RouteStatus {
  planned
  ridden
  foundOnline
}

model Activity {
  id               String   @id @default(uuid())
  routeId          String
  userId           String? // Strava user ID (nullable for manual imports)
  stravaActivityId String?  @unique
  title            String?  // Activity title (from Strava or manual entry)
  riddenAt         DateTime
  duration         Int? // seconds
  avgHr            Int?
  maxHr            Int?
  notes            String?
  weather          String? // JSON: Open-Meteo data for ride date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("activities")
}
