datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client"
  output     = "src/lib/client"
  engineType = "client"
}

model Route {
  id            String      @id @default(uuid())
  name          String
  description   String?
  gpxContent    String      // Raw GPX XML
  polyline      Json        // [{ lat: Float, lng: Float }]
  stats         Json        // { distance, elevationGain, elevationLoss }
  source        RouteSource
  status        RouteStatus @default(planned)
  ratingTags    Json        // ["Nochmal fahren", "Anpassung nötig", ...]
  notes         String?
  stravaRouteId String?     @unique
  stravaActivityId String?   @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  fahrten       Fahrt[]

  @@map("routes")
}

enum RouteSource {
  stravaRoute
  stravaActivity
  manualImport
}

enum RouteStatus {
  planned
  ridden
  foundOnline
}

model Fahrt {
  id              String   @id @default(uuid())
  routeId         String
  stravaActivityId String?  @unique
  riddenAt        DateTime
  duration        Int?     // seconds
  avgHr           Int?
  maxHr           Int?
  notes           String?
  weather         String?  // JSON: Open-Meteo data for ride date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("fahrten")
}
