{
  "name": "gpx-toolbox-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gpx-toolbox/utils/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/gpx-toolbox/utils",
        "tsConfig": "libs/gpx-toolbox/utils/tsconfig.lib.json",
        "packageJson": "libs/gpx-toolbox/utils/package.json",
        "main": "libs/gpx-toolbox/utils/src/index.ts",
        "assets": ["libs/gpx-toolbox/utils/*.md"]
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/coverage/libs/gpx-toolbox-utils"],
      "options": {
        "config": "./vite.config.mts"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    }
  }
}
