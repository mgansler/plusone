{
  "name": "gpx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gpx/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/gpx",
        "tsConfig": "libs/gpx/tsconfig.lib.json",
        "packageJson": "libs/gpx/package.json",
        "main": "libs/gpx/src/index.ts",
        "assets": ["libs/gpx/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "libs/gpx/vite.config.mts",
        "codeCoverage": true
      }
    }
  }
}
