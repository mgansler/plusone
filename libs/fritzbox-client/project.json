{
  "name": "fritzbox-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/fritzbox-client/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "outputs": ["{workspaceRoot}/coverage/libs/fritzbox-client"],
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../coverage/libs/fritzbox-client"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    }
  }
}
