{
  "name": "github-hooks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/github-hooks/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/libs/github-hooks"],
      "options": {
        "coverage": true,
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/libs/github-hooks"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/github-hooks/tsconfig.lib.json",
          "tsc --noEmit -p libs/github-hooks/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
