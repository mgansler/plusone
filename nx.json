{
  "targetDependencies": {
    "test": [
      {
        "target": "test",
        "projects": "dependencies"
      }
    ],
    "build": [
      {
        "target": "build",
        "projects": "dependencies"
      }
    ]
  },
  "generators": {
    "@nx/web:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "vitest",
      "e2eTestRunner": "cypress"
    },
    "@nx/web:library": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "vitest"
    },
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "none",
        "linter": "eslint",
        "bundler": "vite",
        "strict": true
      },
      "component": {
        "style": "none"
      },
      "library": {
        "style": "none",
        "linter": "eslint",
        "strict": true,
        "unitTestRunner": "vitest"
      }
    }
  },
  "defaultProject": "github-pipeline-status",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.github/workflows/verify.yml",
      "{workspaceRoot}/.gitlab-ci.yml",
      "{workspaceRoot}/babel.config.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/eslint.config.js"
    ]
  },
  "targetDefaults": {
    "@nx/web:file-server": {
      "options": {
        "host": "127.0.0.1"
      }
    },
    "build": [
      {
        "inputs": ["production", "^production"],
        "cache": true,
        "dependsOn": ["^build"]
      },
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "production",
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        }
      }
    ],
    "e2e": [
      {
        "inputs": ["default", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/cypress/plugin"
        },
        "options": {
          "config-file": "./cypress.config.ts"
        }
      }
    ],
    "component-test": [
      {
        "inputs": ["default", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/cypress/plugin"
        },
        "options": {
          "config-file": "./cypress.config.ts"
        }
      }
    ],
    "test": [
      {
        "filter": {
          "plugin": "@nx/vitest"
        },
        "options": {
          "watch": false
        }
      }
    ],
    "prisma-generate": {
      "inputs": [
        "default",
        "{projectRoot}/schema.prisma",
        {
          "externalDependencies": ["@prisma/client", "prisma"]
        }
      ],
      "outputs": ["{projectRoot}/src/lib/client/**"],
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "workspaceLayout": {
    "projectNameAndRootFormat": "as-provided"
  },
  "parallel": 1,
  "defaultBase": "main",
  "useInferencePlugins": false,
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/borgo/borgo-e2e/**/*",
        "apps/borgo/borgo-web/**/*",
        "apps/elgato/elgato-backend/**/*",
        "apps/elgato/elgato-e2e/**/*",
        "apps/elgato/elgato-web/**/*",
        "apps/feeds/feeds-backend/**/*",
        "apps/feeds/feeds-dummy-rss-server/**/*",
        "apps/feeds/feeds-e2e/**/*",
        "apps/feeds/feeds-web/**/*",
        "apps/github-pipeline-status/**/*",
        "apps/github-pipeline-status-e2e/**/*",
        "apps/gpx-toolbox/gpx-toolbox-backend/**/*",
        "apps/gpx-toolbox/gpx-toolbox-web/**/*",
        "apps/gpx-toolbox/gpx-toolbox-app/**/*",
        "apps/stgtrails/stgtrails-backend/**/*",
        "apps/stgtrails/stgtrails-e2e/**/*",
        "apps/stgtrails/stgtrails-web/**/*",
        "libs/components/**/*",
        "libs/dark-mode-theme-provider/**/*",
        "libs/dom-utils/**/*",
        "libs/elgato/api-client/**/*",
        "libs/elgato/persistence/**/*",
        "libs/feeds/api-client/**/*",
        "libs/feeds/persistence/**/*",
        "libs/fritzbox-client/**/*",
        "libs/github-hooks/**/*",
        "libs/hooks/**/*",
        "libs/nestjs-services/**/*",
        "libs/packages/cypress-graphql/**/*",
        "libs/plugins/nx-prisma/**/*",
        "libs/gpx-toolbox/api-client/**/*",
        "libs/gpx-toolbox/persistence/**/*",
        "libs/stgtrails/api-client/**/*",
        "libs/stgtrails/persistence/**/*",
        "libs/validated-query-factory/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": [
        "apps/borgo/borgo-e2e/**/*",
        "apps/elgato/elgato-e2e/**/*",
        "apps/feeds/feeds-e2e/**/*",
        "apps/github-pipeline-status-e2e/**/*",
        "apps/stgtrails/stgtrails-e2e/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "component-test",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": [
        "apps/elgato/elgato-web/**/*",
        "apps/github-pipeline-status/**/*",
        "apps/gpx-toolbox/gpx-toolbox-web/**/*",
        "apps/stgtrails/stgtrails-web/**/*",
        "libs/components/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": ["tools/eslint-rules/**/*"]
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      },
      "include": [
        "apps/elgato/elgato-backend/**/*",
        "apps/feeds/feeds-backend/**/*",
        "apps/feeds/feeds-dummy-rss-server/**/*",
        "apps/gpx-toolbox/gpx-toolbox-backend/**/*",
        "apps/stgtrails/stgtrails-backend/**/*"
      ]
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      },
      "include": [
        "apps/borgo/borgo-web/**/*",
        "apps/elgato/elgato-web/**/*",
        "apps/feeds/feeds-web/**/*",
        "apps/github-pipeline-status/**/*",
        "apps/gpx-toolbox/gpx-toolbox-web/**/*",
        "apps/stgtrails/stgtrails-web/**/*",
        "libs/fritzbox-client/**/*"
      ]
    }
  ],
  "affected": {
    "legacy": true
  }
}
