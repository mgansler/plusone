{
  "name": "gpx-toolbox-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gpx-toolbox/gpx-toolbox-web/src",
  "tags": [],
  "targets": {
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "host": "0.0.0.0",
        "port": 4250
      },
      "configurations": {
        "development": {},
        "production": {
          "mode": "production"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "gpx-toolbox-web:build",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/gpx-toolbox/gpx-toolbox-web"],
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../../coverage/apps/gpx-toolbox/gpx-toolbox-web"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "component-test": {
      "outputs": [
        "{workspaceRoot}/reports/component-test/gpx-toolbox-web",
        "{workspaceRoot}/dist/cypress/apps/gpx-toolbox/gpx-toolbox-web/videos",
        "{workspaceRoot}/dist/cypress/apps/gpx-toolbox/gpx-toolbox-web/screenshots"
      ]
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
