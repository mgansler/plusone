        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 123456
          },
          "firstname": {
            "type": "string",
            "example": "John"
          },
          "lastname": {
            "type": "string",
            "example": "Doe"
          },
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "profile": {
            "type": "object"
          },
          "profile_medium": {
            "type": "object"
          },
          "city": {
            "type": "object"
          },
          "state": {
            "type": "object"
          },
          "country": {
            "type": "object"
          },
          "gender": {
            "type": "string",
            "example": "M"
          },
          "weight": {
            "type": "object"
          },
          "friend": {
            "type": "object"
          },
          "follower": {
            "type": "object"
          },
          "athleteType": {
            "type": "string",
            "example": "cyclist"
          },
          "premium": {
            "type": "boolean"
          },
          "summit": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "follower_count": {
            "type": "number"
          },
          "friend_count": {
            "type": "number"
          },
          "measurement_preference": {
            "type": "string"
          },
          "ftp": {
            "type": "object"
          },
          "clubs": {
            "type": "object"
          },
          "bikes": {
            "type": "object"
          },
          "shoes": {
            "type": "object"
          },
          "localStats": {
            "type": "object"
          }
        },
        "required": ["id", "firstname", "lastname", "username", "gender", "athleteType"]
      },
      "ImportResultDto": {
        "type": "object",
        "properties": {
          "imported": {
            "type": "number",
            "description": "Number of routes/activities imported"
          },
          "matched": {
            "type": "number",
            "description": "Number matched to existing routes"
          },
          "newRoutes": {
            "type": "number",
            "description": "Number of new routes created"
          }
        },
        "required": ["imported", "matched", "newRoutes"]
      },
      "StravaRouteSummaryDto": {
        "type": "object",
        "properties": {
          "stravaId": {
            "type": "number",
            "description": "Strava route ID"
          },
          "name": {
            "type": "string",
            "description": "Route name"
          },
          "description": {
            "type": "string",
            "description": "Route description"
          },
          "distance": {
            "type": "number",
            "description": "Distance in meters"
          },
          "elevationGain": {
            "type": "number",
            "description": "Elevation gain in meters"
          },
          "imported": {
            "type": "boolean",
            "description": "Whether already imported"
          }
        },
        "required": ["stravaId", "name", "imported"]
      },
      "FahrtRouteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Route ID"
          },
          "name": {
            "type": "string",
            "description": "Route name"
          },
          "status": {
            "type": "string",
            "description": "Route status"
          },
          "stats": {
            "type": "object",
            "description": "Route stats"
          }
        },
        "required": ["id", "name"]
      },
      "FahrtResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Fahrt ID"
          },
          "routeId": {
            "type": "string",
            "description": "Route ID"
          },
          "riddenAt": {
            "format": "date-time",
            "type": "string",
            "description": "Ridden date and time"
          },
          "duration": {
            "type": "object",
            "description": "Duration in seconds"
          },
          "avgHr": {
            "type": "object",
            "description": "Average heart rate"
          },
          "maxHr": {
            "type": "object",
            "description": "Maximum heart rate"
          },
          "notes": {
            "type": "object",
            "description": "Personal notes"
          },
          "weather": {
            "type": "object",
            "description": "Weather conditions summary"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Created at"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Updated at"
          },
          "route": {
            "description": "Parent route",
            "allOf": [
              {
                "$ref": "#/components/schemas/FahrtRouteResponseDto"
              }
            ]
          }
        },
        "required": ["id", "routeId", "riddenAt", "createdAt", "updatedAt"]
      },
      "CreateFahrtDto": {
        "type": "object",
        "properties": {
          "riddenAt": {
            "type": "string",
            "description": "Date and time of the ride (ISO 8601)"
          },
          "duration": {
            "type": "number",
            "description": "Duration in seconds"
          },
          "avgHr": {
            "type": "number",
            "description": "Average heart rate"
          },
          "maxHr": {
            "type": "number",
            "description": "Maximum heart rate"
          },
          "notes": {
            "type": "string",
            "description": "Personal notes"
          },
          "weather": {
            "type": "string",
            "description": "Weather conditions summary"
          }
        },
        "required": ["riddenAt"]
      },
      "UpdateFahrtDto": {
        "type": "object",
        "properties": {
          "riddenAt": {
            "type": "string",
            "description": "Date and time of the ride (ISO 8601)"
          },
          "duration": {
            "type": "number",
            "description": "Duration in seconds"
          },
          "avgHr": {
            "type": "number",
            "description": "Average heart rate"
          },
          "maxHr": {
            "type": "number",
            "description": "Maximum heart rate"
          },
          "notes": {
            "type": "string",
