            "type": "array",
            "description": "List of rides"
          },
          "createdAt": {
            "type": "string",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "description": "Last update timestamp"
          },
          "polyline": {
            "description": "Route polyline coordinates",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "name", "source", "status", "createdAt", "updatedAt"]
      },
      "UpdateRouteDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Route name"
          },
          "description": {
            "type": "string",
            "description": "Route description"
          },
          "status": {
            "type": "string",
            "description": "Route status",
            "enum": ["planned", "ridden", "foundOnline"]
          },
          "ratingTags": {
            "description": "Rating tags",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string",
            "description": "Notes"
          }
        }
      },
