{
  "name": "borgo-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/borgo/borgo-web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/borgo/borgo-web"],
      "options": {
        "coverage": true,
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../../coverage/apps/borgo/borgo-web"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "borgo-web:build",
        "spa": true,
        "port": 4100
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {
          "mode": "production"
        }
      }
    },
    "preview": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/borgo/borgo-web/tsconfig.app.json",
          "tsc --noEmit -p apps/borgo/borgo-web/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
