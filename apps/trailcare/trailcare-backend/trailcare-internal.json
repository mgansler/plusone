  "info": {
    "title": "Trailcare API",
    "description": "",
    "version": "0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "trailcare_session"
      }
    },
    "schemas": {
      "SweepStatus": {
        "type": "string",
        "enum": [
          "GREEN",
          "YELLOW",
          "RED"
        ]
      },
      "CareType": {
        "type": "string",
        "enum": [
          "SWEPT",
          "CUT_BACK",
          "REPAIR",
          "INSPECTION",
          "FALLEN_TREE"
        ]
      },
      "CareEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "trailId": {
            "type": "number"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CareType"
              }
            ]
          },
          "performedAt": {
            "format": "date-time",
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "performedBy": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "undoableUntil": {
            "format": "date-time",
            "type": "string",
            "description": "Set when the current session may still undo this entry"
          }
        },
        "required": [
          "id",
          "trailId",
          "type",
          "performedAt",
          "createdAt"
        ]
      },
      "TrailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "trailAreaId": {
            "type": "number"
          },
          "trailAreaName": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sweepGreenMaxDays": {
            "type": "number"
          },
          "sweepYellowMaxDays": {
            "type": "number"
          },
          "sweepStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SweepStatus"
              }
            ]
          },
          "lastSweptAt": {
            "format": "date-time",
            "type": "string"
          },
          "daysSinceSwept": {
            "type": "number",
            "description": "Calendar days since the last sweep, 0 = today"
          },
          "lastCareEntry": {
            "$ref": "#/components/schemas/CareEntryDto"
          }
        },
        "required": [
          "id",
          "name",
          "trailAreaId",
          "trailAreaName",
          "aliases",
          "sweepGreenMaxDays",
          "sweepYellowMaxDays",
          "sweepStatus"
        ]
      },
      "TrailAreaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "trails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrailDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "trails"
        ]
      },
      "CreateCareEntryDto": {
        "type": "object",
        "properties": {
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CareType"
              }
            ]
          },
          "performedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Defaults to now"
          },
          "comment": {
            "type": "string"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "UpdateCareEntryDto": {
        "type": "object",
