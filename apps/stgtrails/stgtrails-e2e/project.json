{
  "name": "stgtrails-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/stgtrails/stgtrails-e2e/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["stgtrails-backend", "stgtrails-web", "stgtrails-persistence"],
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "target": "setup-db",
          "projects": ["stgtrails-e2e"]
        },
        {
          "target": "build",
          "projects": ["stgtrails-web"]
        }
      ],
      "configurations": {
        "watch": {
          "command": "cypress run --config baseUrl=http://localhost:4104",
          "headed": true,
          "no-exit": true
        }
      }
    },
    "setup-db": {
      "executor": "nx:run-commands",
      "options": {
        "env": {
          "STGTRAILS_DATABASE_URL": "file:./stgtrails-e2e.db"
        },
        "commands": [
          "rm -f libs/stgtrails/persistence/stgtrails-e2e.db",
          "prisma --config libs/stgtrails/persistence/prisma.config.ts generate",
          "prisma --config libs/stgtrails/persistence/prisma.config.ts migrate deploy",
          "ts-node libs/stgtrails/persistence/src/seed.ts"
        ],
        "parallel": false
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p apps/stgtrails/stgtrails-e2e/tsconfig.json"],
        "parallel": false
      }
    }
  }
}
