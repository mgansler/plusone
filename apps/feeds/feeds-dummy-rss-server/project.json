{
  "name": "feeds-dummy-rss-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/feeds/feeds-dummy-rss-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "feeds-dummy-rss-server:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "feeds-dummy-rss-server:build:development"
        },
        "production": {
          "buildTarget": "feeds-dummy-rss-server:build:production"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p apps/feeds/feeds-dummy-rss-server/tsconfig.app.json"],
        "parallel": false
      }
    }
  }
}
