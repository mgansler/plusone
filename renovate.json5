{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':pinAllExceptPeerDependencies', 'group:allNonMajor'],
  automerge: false,
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      matchPackageNames: ['node'],
      allowedVersions: '24.x',
    },
    {
      // nginx:stable-alpine has no version in its tag, so updates are only possible via digest
      matchDatasources: ['docker'],
      matchPackageNames: ['nginx'],
      pinDigests: true,
    },
    {
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      matchPackageNames: ['vite'],
      allowedVersions: '8.0.x',
    },
  ],
}
